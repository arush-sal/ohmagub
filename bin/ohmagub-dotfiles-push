#!/usr/bin/env bash
#
# ohmagub-dotfiles-push — commit any changes in the dotfiles repo and push.
# Called by ohmagub-dotfiles-watch (debounced). Safe to run by hand too.
# Uses a normal (non-force) push — no `git yolo`.

set -euo pipefail
REPO="${OHMAGUB_DOTFILES_PATH:-$HOME/Documents/dotfiles}"
[ -d "$REPO/.git" ] || { echo "no git repo at $REPO" >&2; exit 1; }
cd "$REPO"

# Nothing to do?
[ -n "$(git status --porcelain)" ] || exit 0

git add -A
git commit -q -m "ohmagub auto-sync: $(date '+%Y-%m-%d %H:%M:%S')" || exit 0

if git push -q; then
  command -v notify-send >/dev/null 2>&1 && notify-send -a ohmagub "dotfiles synced" "pushed to $(git rev-parse --abbrev-ref --symbolic-full-name @{u} 2>/dev/null || echo origin)"
else
  command -v notify-send >/dev/null 2>&1 && notify-send -u critical -a ohmagub "dotfiles push failed" "resolve manually in $REPO (diverged? auth?)"
  echo "push failed — resolve manually in $REPO" >&2
  exit 1
fi
