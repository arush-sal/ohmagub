#!/usr/bin/env bash
#
# omagub — manage your setup.
#   omagub install            run all phases (full setup)
#   omagub phase <name|num>   run a single phase (idempotent)
#   omagub phases             list phases
#   omagub update             git pull, then re-run all phases
#   omagub version | help

set -euo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
export OMAGUB_PATH="$(cd "$(dirname "$SELF")/.." && pwd)"

usage() {
  sed -n '3,9p' "$SELF" | sed 's/^# \{0,1\}//'
  echo
  bash "$OMAGUB_PATH/install.sh" list
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    install)        bash "$OMAGUB_PATH/install.sh" all ;;
    phase)          [ $# -ge 1 ] || { echo "usage: omagub phase <name|num>"; exit 1; }; bash "$OMAGUB_PATH/install.sh" "$1" ;;
    phases|list)    bash "$OMAGUB_PATH/install.sh" list ;;
    update)         git -C "$OMAGUB_PATH" pull --ff-only && bash "$OMAGUB_PATH/install.sh" all ;;
    version|-v|--version) echo "omagub $(git -C "$OMAGUB_PATH" describe --tags --always 2>/dev/null || echo dev)" ;;
    help|-h|--help) usage ;;
    *) echo "unknown command: $cmd" >&2; usage; exit 1 ;;
  esac
}
main "$@"
